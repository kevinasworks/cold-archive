# Spotlight records may be stale, derived from content, or require indexing.
# Read file metadata directly; the native filesystem adapter reports xattrs.
use Image::ExifTool::MacOS;
no warnings 'redefine';
*Image::ExifTool::MacOS::ExtractMDItemTags = sub ($$) { return; };
1;
